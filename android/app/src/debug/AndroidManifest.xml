<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
 <!-- Test-only action channel (B-025): debug builds only, guarded by
      android.permission.DUMP so only adb's shell (and root) can send it.
      Third-party apps cannot hold DUMP. The release build has no receiver. -->
 <application>
  <receiver
      android:name=".HarnessReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP"/>
  <!-- Debug builds keep the harness one tap away AND exported; the main manifest now
       ships exported=false (audit B-138: the release harness is a code-exec surface),
       so this re-export needs tools:replace. Release builds have only HomeActivity
       with the LAUNCHER category (UX_AUDIT P6). -->
  <activity
      android:name=".HarnessActivity"
      android:exported="true"
      tools:replace="android:exported">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
    <category android:name="android.intent.category.LAUNCHER"/>
   </intent-filter>
  </activity>
 </application>
</manifest>
